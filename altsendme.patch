@@ -0,0 +1,339 @@
+use anyhow::anyhow;
+use anyhow::Result;
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+const ALIAS_TTL_SECS: u64 = 15 * 60;
+const ALIAS_MIN_LEN: usize = 4;
+const ALIAS_MAX_LEN: usize = 32;
+
+#[derive(Debug, Clone)]
+struct AliasEntry {
+    blob_ticket: String,
+    registered_at: Instant,
+}
+
+#[derive(Debug, Default)]
+pub struct LanAliasRegistry {
+    aliases: HashMap<String, AliasEntry>,
+}
+
+impl LanAliasRegistry {
+    pub fn new() -> Self {
+        Self {
+            aliases: HashMap::new(),
+        }
+    }
+
+    pub fn normalize_alias(raw: &str) -> Result<String> {
+        let trimmed = raw.trim();
+
+        if !trimmed.is_ascii() {
+            return Err(anyhow!("Alias must contain only ASCII characters"));
+        }
+
+        let normalized = trimmed.to_ascii_lowercase();
+
+        if normalized.len() < ALIAS_MIN_LEN || normalized.len() > ALIAS_MAX_LEN {
+            return Err(anyhow!(
+                "Alias length must be {}-{} characters",
+                ALIAS_MIN_LEN,
+                ALIAS_MAX_LEN
+            ));
+        }
+
+        if !normalized
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-')
+        {
+            return Err(anyhow!("Alias must contain only [a-z0-9_-]"));
+        }
+
+        Ok(normalized)
+    }
+
+    pub fn register(&mut self, alias: &str, blob_ticket: &str) -> Result<()> {
+        let normalized = Self::normalize_alias(alias)?;
+
+        if self.aliases.contains_key(&normalized) {
+            return Err(anyhow!("Alias already registered"));
+        }
+
+        self.aliases.insert(
+            normalized,
+            AliasEntry {
+                blob_ticket: blob_ticket.to_string(),
+                registered_at: Instant::now(),
+            },
+        );
+
+        Ok(())
+    }
+
+    pub fn resolve(&mut self, alias: &str) -> Result<String> {
+        let normalized = Self::normalize_alias(alias)?;
+
+        if let Some(entry) = self.aliases.get(&normalized) {
+            let elapsed = entry.registered_at.elapsed();
+
+            if elapsed > Duration::from_secs(ALIAS_TTL_SECS) {
+                self.aliases.remove(&normalized);
+                return Err(anyhow!("Alias expired"));
+            }
+
+            return Ok(entry.blob_ticket.clone());
+        }
+
+        Err(anyhow!("Alias not found"))
+    }
+
+    pub fn clear(&mut self) {
+        self.aliases.clear();
+    }
+
+    pub fn prune_expired(&mut self) {
+        let now = Instant::now();
+        self.aliases.retain(|_, entry| {
+            now.duration_since(entry.registered_at) < Duration::from_secs(ALIAS_TTL_SECS)
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_normalize_valid() {
+        let cases = vec![
+            ("MyCode123", "mycode123"),
+            ("  foo-bar_42  ", "foo-bar_42"),
+            ("UPPERCASE", "uppercase"),
+        ];
+        for (input, expected) in cases {
+            let result = LanAliasRegistry::normalize_alias(input).unwrap();
+            assert_eq!(result, expected);
+        }
+    }
+
+    #[test]
+    fn test_normalize_rejects_non_ascii() {
+        let cases = vec!["café", "日本語", "naïve", "Übung"];
+        for input in cases {
+            let result = LanAliasRegistry::normalize_alias(input);
+            assert!(result.is_err());
+            assert!(result.unwrap_err().to_string().contains("ASCII"));
+        }
+    }
+
+    #[test]
+    fn test_normalize_too_short() {
+        assert!(LanAliasRegistry::normalize_alias("foo").is_err());
+    }
+
+    #[test]
+    fn test_normalize_too_long() {
+        let long = "a".repeat(33);
+        assert!(LanAliasRegistry::normalize_alias(&long).is_err());
+    }
+
+    #[test]
+    fn test_normalize_invalid_chars() {
+        let cases = vec!["foo@bar", "code#123", "test.com", "foo bar"];
+        for input in cases {
+            assert!(LanAliasRegistry::normalize_alias(input).is_err());
+        }
+    }
+
+    #[test]
+    fn test_register_and_resolve() {
+        let mut registry = LanAliasRegistry::new();
+        let ticket = "real_blob_ticket_xyz";
+        registry.register("myalias", ticket).unwrap();
+
+        let resolved = registry.resolve("myalias").unwrap();
+        assert_eq!(resolved, ticket);
+    }
+
+    #[test]
+    fn test_unknown_alias() {
+        let mut registry = LanAliasRegistry::new();
+        assert!(registry.resolve("unknown").is_err());
+    }
+
+    #[test]
+    fn test_clear() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("alias1", "ticket1").unwrap();
+        registry.register("alias2", "ticket2").unwrap();
+
+        registry.clear();
+        assert!(registry.resolve("alias1").is_err());
+        assert!(registry.resolve("alias2").is_err());
+    }
+
+    #[test]
+    fn test_no_collision_overwrite() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("samealias", "ticket1").unwrap();
+
+        let result = registry.register("samealias", "ticket2");
+        assert!(result.is_err());
+
+        let resolved = registry.resolve("samealias").unwrap();
+        assert_eq!(resolved, "ticket1");
+    }
+
+    #[test]
+    fn test_ttl_expired_is_removed() {
+        let mut registry = LanAliasRegistry::new();
+        let ticket = "ticket";
+        registry.register("myalias", ticket).unwrap();
+
+        if let Some(entry) = registry.aliases.get_mut("myalias") {
+            entry.registered_at =
+                Instant::now() - Duration::from_secs(ALIAS_TTL_SECS + 1);
+        }
+
+        let result = registry.resolve("myalias");
+        assert!(result.is_err());
+        assert!(result.unwrap_err().to_string().contains("expired"));
+        assert!(!registry.aliases.contains_key("myalias"));
+    }
+
+    #[test]
+    fn test_expired_vs_missing_distinction() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("expired", "ticket1").unwrap();
+        registry.register("fresh", "ticket2").unwrap();
+
+        if let Some(entry) = registry.aliases.get_mut("expired") {
+            entry.registered_at =
+                Instant::now() - Duration::from_secs(ALIAS_TTL_SECS + 1);
+        }
+
+        let expired_result = registry.resolve("expired");
+        assert!(expired_result.is_err());
+        assert!(expired_result
+            .unwrap_err()
+            .to_string()
+            .contains("expired"));
+
+        let missing_result = registry.resolve("unknown");
+        assert!(missing_result.is_err());
+        assert!(missing_result.unwrap_err().to_string().contains("not found"));
+
+        let fresh_result = registry.resolve("fresh");
+        assert!(fresh_result.is_ok());
+        assert_eq!(fresh_result.unwrap(), "ticket2");
+    }
+
+    #[test]
+    fn test_unique_match() {
+        let mut registry = LanAliasRegistry::new();
+        let ticket = "unique_ticket_123";
+        registry.register("uniquealias", ticket).unwrap();
+
+        let resolved = registry.resolve("uniquealias").unwrap();
+        assert_eq!(resolved, ticket);
+    }
+
+    #[test]
+    fn test_ambiguity_single_registry() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("shared", "peer1_ticket").unwrap();
+
+        let resolved = registry.resolve("shared").unwrap();
+        assert_eq!(resolved, "peer1_ticket");
+    }
+
+    #[test]
+    fn test_timeout_scenario() {
+        let mut registry = LanAliasRegistry::new();
+        let result = registry.resolve("nonexistent");
+        assert!(result.is_err());
+        assert!(result.unwrap_err().to_string().contains("not found"));
+    }
+
+    #[test]
+    fn test_registry_default() {
+        let registry = LanAliasRegistry::default();
+        assert!(registry.aliases.is_empty());
+    }
+
+    #[test]
+    fn test_prune_expired_removes_only_stale() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("fresh", "ticket1").unwrap();
+        registry.register("stale", "ticket2").unwrap();
+
+        if let Some(entry) = registry.aliases.get_mut("stale") {
+            entry.registered_at =
+                Instant::now() - Duration::from_secs(ALIAS_TTL_SECS + 1);
+        }
+
+        registry.prune_expired();
+
+        assert!(registry.aliases.contains_key("fresh"));
+        assert!(!registry.aliases.contains_key("stale"));
+    }
+
+    #[test]
+    fn test_nonce_not_in_registry() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("test", "ticket").unwrap();
+
+        let entry = registry.aliases.get("test").unwrap();
+        assert_eq!(entry.blob_ticket, "ticket");
+    }
+}

