+#[cfg(test)]
+mod alias_lookup_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn alias_lookup_round_trips() {
+        let (mut client, mut server) = tokio::io::duplex(4096);
+
+        let sent = ControlMessage::AliasLookupRequest {
+            alias: "my-code".to_string(),
+            lookup_nonce: 42,
+        };
+
+        write_message(&mut client, &sent).await.unwrap();
+
+        match read_message(&mut server).await.unwrap() {
+            ControlMessage::AliasLookupRequest {
+                alias,
+                lookup_nonce,
+            } => {
+                assert_eq!(alias, "my-code");
+                assert_eq!(lookup_nonce, 42);
+            }
+            other => panic!("expected AliasLookupRequest, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn kind_matches_the_serde_tag_for_alias_messages() {
+        let messages = [
+            ControlMessage::AliasLookupRequest {
+                alias: "test".to_string(),
+                lookup_nonce: 1,
+            },
+            ControlMessage::AliasLookupResponse {
+                success: true,
+                blob_ticket: Some("ticket".to_string()),
+                error_message: None,
+                lookup_nonce: 1,
+            },
+        ];
+
+        for message in messages {
+            let value = serde_json::to_value(&message).unwrap();
+            assert_eq!(
+                value.get("kind").and_then(serde_json::Value::as_str),
+                Some(message.kind())
+            );
+        }
+    }
+}
