+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum AliasResolutionOutcome {
+    #[serde(rename = "uniqueMatch")]
+    UniqueMatch {
+        blob_ticket: String,
+    },
+    #[serde(rename = "notFound")]
+    NotFound,
+    #[serde(rename = "ambiguous")]
+    Ambiguous {
+        endpoint_ids: Vec<String>,
+    },
+    #[serde(rename = "error")]
+    Error {
+        message: String,
+    },
+}
+
+#[cfg(any(desktop, target_os = "android"))]
+#[tauri::command]
+pub async fn register_lan_alias(
+    alias: String,
+    blob_ticket: String,
+    state: State<'_, AppStateMutex>,
+) -> Result<(), String> {
+    let app_state = state.lock().await;
+    let node = app_state.node.as_ref().ok_or("Node not initialized")?;
+
+    let current_ticket = app_state
+        .current_share
+        .as_ref()
+        .map(|share| share.ticket.clone())
+        .ok_or("No active share")?;
+
+    if blob_ticket != current_ticket {
+        return Err("BlobTicket does not match current share".to_string());
+    }
+
+    node.register_lan_alias(&alias, &blob_ticket)
+        .await
+        .map_err(|e| format!("Failed to register alias: {}", e))
+}
+
+#[cfg(any(desktop, target_os = "android"))]
+#[tauri::command]
+pub async fn clear_lan_alias(
+    state: State<'_, AppStateMutex>,
+) -> Result<(), String> {
+    let app_state = state.lock().await;
+    let node = app_state.node.as_ref().ok_or("Node not initialized")?;
+
+    node.clear_lan_alias()
+        .await
+        .map_err(|e| format!("Failed to clear alias: {}", e))
+}
+
+#[cfg(any(desktop, target_os = "android"))]
+#[tauri::command]
+pub async fn resolve_lan_alias(
+    alias: String,
+    state: State<'_, AppStateMutex>,
+) -> Result<AliasResolutionOutcome, String> {
+    let app_state = state.lock().await;
+    let node = app_state.node.as_ref().ok_or("Node not initialized")?;
+
+    let nearby_peers: Vec<_> = node
+        .list_nearby()
+        .await
+        .into_iter()
+        .filter(|d| d.identified)
+        .collect();
+
+    if nearby_peers.is_empty() {
+        return Ok(AliasResolutionOutcome::Error {
+            message: "No nearby peers discovered".to_string(),
+        });
+    }
+
+    let lookup_nonce = {
+        use std::collections::hash_map::RandomState;
+        use std::hash::{BuildHasher, Hasher};
+        let mut hasher = RandomState::new().build_hasher();
+        hasher.write_u64(
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_nanos() as u64)
+                .unwrap_or(0),
+        );
+        hasher.finish()
+    };
+
+    let mut responses: std::collections::HashMap<String, String> = std::collections::HashMap::new();
+    let timeout = std::time::Duration::from_secs(5);
+
+    let query_futures: Vec<_> = nearby_peers
+        .iter()
+        .map(|peer| {
+            let peer_id = peer.endpoint_id.clone();
+            let node = node.clone();
+            let alias = alias.clone();
+            let nonce = lookup_nonce;
+            async move {
+                match tokio::time::timeout(
+                    timeout,
+                    node.resolve_lan_alias_over_control(&peer_id, &alias, nonce),
+                )
+                .await
+                {
+                    Ok(Ok(ticket)) => Some((peer_id, ticket)),
+                    _ => None,
+                }
+            }
+        })
+        .collect();
+
+    let results = futures_util::future::join_all(query_futures).await;
+
+    for result in results {
+        if let Some((endpoint_id, ticket)) = result {
+            responses.insert(endpoint_id, ticket);
+        }
+    }
+
+    match responses.len() {
+        0 => Ok(AliasResolutionOutcome::NotFound),
+        1 => {
+            let blob_ticket = responses.into_values().next().unwrap();
+            Ok(AliasResolutionOutcome::UniqueMatch { blob_ticket })
+        }
+        _ => {
+            let endpoint_ids = responses.into_keys().collect();
+            Ok(AliasResolutionOutcome::Ambiguous { endpoint_ids })
+        }
+    }
+}
+
+#[cfg(not(any(desktop, target_os = "android")))]
