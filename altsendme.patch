 pub fn unpaired_message_allowed(msg: &ControlMessage) -> bool {
     matches!(
         msg,
         ControlMessage::WhoAreYou
             | ControlMessage::Invite { .. }
             | ControlMessage::InviteResponse { .. }
             | ControlMessage::PairRequest { .. }
+            | ControlMessage::AliasLookupRequest { .. }
     )
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn alias_lookup_policy() {
+        assert!(unpaired_message_allowed(
+            &ControlMessage::AliasLookupRequest {
+                alias: "test-code".to_string(),
+                lookup_nonce: 42,
+            }
+        ));
+
+        assert!(!unpaired_message_allowed(
+            &ControlMessage::AliasLookupResponse {
+                success: true,
+                blob_ticket: Some("ticket".to_string()),
+                error_message: None,
+                lookup_nonce: 42,
+            }
+        ));
+    }
+}

