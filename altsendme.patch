+#[derive(Debug, serde::Serialize)]
+#[serde(tag = "status", rename_all = "camelCase")]
+pub enum AliasResolutionOutcome {
+    UniqueMatch {
+        #[serde(rename = "blobTicket")]
+        blob_ticket: String,
+    },
+    NotFound,
+    Ambiguous {
+        #[serde(rename = "endpointIds")]
+        endpoint_ids: Vec<String>,
+    },
+    Error {
+        message: String,
+    },
+}
+
+#[cfg(any(desktop, target_os = "android"))]
+#[tauri::command]
+pub async fn register_lan_alias(
+    alias: String,
+    blob_ticket: String,
+    state: State<'_, AppStateMutex>,
+) -> Result<(), String> {
+    let node = {
+        let app_state = state.lock().await;
+
+        let node = app_state
+            .node
+            .clone()
+            .ok_or_else(|| "Node not initialized".to_string())?;
+
+        let current_ticket = app_state
+            .current_share
+            .as_ref()
+            .map(|share| share.ticket.clone())
+            .ok_or_else(|| "No active share".to_string())?;
+
+        if blob_ticket != current_ticket {
+            return Err("BlobTicket does not match current share".to_string());
+        }
+
+        node
+    };
+
+    node.register_lan_alias(&alias, &blob_ticket)
+        .await
+        .map_err(|error| format!("Failed to register alias: {error}"))
+}
+
+#[cfg(any(desktop, target_os = "android"))]
+#[tauri::command]
+pub async fn clear_lan_alias(
+    state: State<'_, AppStateMutex>,
+) -> Result<(), String> {
+    let node = {
+        let app_state = state.lock().await;
+        app_state
+            .node
+            .clone()
+            .ok_or_else(|| "Node not initialized".to_string())?
+    };
+
+    node.clear_lan_alias().await;
+    Ok(())
+}
+
+#[cfg(any(desktop, target_os = "android"))]
+#[tauri::command]
+pub async fn resolve_lan_alias(
+    alias: String,
+    state: State<'_, AppStateMutex>,
+) -> Result<AliasResolutionOutcome, String> {
+    let normalized =
+        engine::LanAliasRegistry::normalize_alias(&alias)
+            .map_err(|error| error.to_string())?;
+
+    let node = {
+        let app_state = state.lock().await;
+        app_state
+            .node
+            .clone()
+            .ok_or_else(|| "Node not initialized".to_string())?
+    };
+
+    let nearby_peers: Vec<_> = node
+        .list_nearby()
+        .await
+        .into_iter()
+        .filter(|device| device.identified)
+        .collect();
+
+    if nearby_peers.is_empty() {
+        return Ok(AliasResolutionOutcome::Error {
+            message: "No nearby peers discovered".to_string(),
+        });
+    }
+
+    let timestamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|duration| duration.as_nanos() as u64)
+        .unwrap_or_default();
+
+    static NONCE_COUNTER: std::sync::atomic::AtomicU64 =
+        std::sync::atomic::AtomicU64::new(1);
+
+    let lookup_nonce = timestamp
+        ^ NONCE_COUNTER.fetch_add(
+            1,
+            std::sync::atomic::Ordering::Relaxed,
+        );
+
+    let mut tasks = tokio::task::JoinSet::new();
+
+    for peer in nearby_peers {
+        let node = node.clone();
+        let alias = normalized.clone();
+        let endpoint_id = peer.endpoint_id;
+
+        tasks.spawn(async move {
+            let result = node
+                .query_lan_alias(
+                    &endpoint_id,
+                    &alias,
+                    lookup_nonce,
+                )
+                .await;
+
+            (endpoint_id, result)
+        });
+    }
+
+    let mut responses =
+        std::collections::HashMap::<String, String>::new();
+
+    while let Some(joined) = tasks.join_next().await {
+        let Ok((endpoint_id, result)) = joined else {
+            continue;
+        };
+
+        match result {
+            Ok(Some(ticket)) => {
+                responses.insert(endpoint_id, ticket);
+            }
+            Ok(None) => {}
+            Err(error) => {
+                tracing::debug!(
+                    target: "dashbeam::_events::control::alias_lookup_failed",
+                    %endpoint_id,
+                    %error,
+                );
+            }
+        }
+    }
+
+    match responses.len() {
+        0 => Ok(AliasResolutionOutcome::NotFound),
+        1 => {
+            let blob_ticket = responses
+                .into_values()
+                .next()
+                .expect("one alias response");
+
+            Ok(AliasResolutionOutcome::UniqueMatch {
+                blob_ticket,
+            })
+        }
+        _ => {
+            let mut endpoint_ids: Vec<_> =
+                responses.into_keys().collect();
+            endpoint_ids.sort();
+
+            Ok(AliasResolutionOutcome::Ambiguous {
+                endpoint_ids,
+            })
+        }
+    }
+}
+
+#[cfg(not(any(desktop, target_os = "android")))]
+#[tauri::command]
+pub async fn register_lan_alias(
+    _alias: String,
+    _blob_ticket: String,
+    _state: State<'_, AppStateMutex>,
+) -> Result<(), String> {
+    Err("LAN alias not available on this platform".to_string())
+}
+
+#[cfg(not(any(desktop, target_os = "android")))]
+#[tauri::command]
+pub async fn clear_lan_alias(
+    _state: State<'_, AppStateMutex>,
+) -> Result<(), String> {
+    Err("LAN alias not available on this platform".to_string())
+}
+
+#[cfg(not(any(desktop, target_os = "android")))]
+#[tauri::command]
+pub async fn resolve_lan_alias(
+    _alias: String,
+    _state: State<'_, AppStateMutex>,
+) -> Result<AliasResolutionOutcome, String> {
+    Err("LAN alias not available on this platform".to_string())
+}

