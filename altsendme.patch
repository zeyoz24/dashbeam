diff --git a/engine/native/src/lan_alias.rs b/engine/native/src/lan_alias.rs
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/engine/native/src/lan_alias.rs
@@ -0,0 +1,365 @@
+use anyhow::anyhow;
+use anyhow::Result;
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+const ALIAS_TTL_SECS: u64 = 15 * 60;
+const ALIAS_MIN_LEN: usize = 4;
+const ALIAS_MAX_LEN: usize = 32;
+
+#[derive(Debug, Clone)]
+struct AliasEntry {
+    blob_ticket: String,
+    registered_at: Instant,
+}
+
+#[derive(Debug, Default)]
+pub struct LanAliasRegistry {
+    aliases: HashMap<String, AliasEntry>,
+}
+
+impl LanAliasRegistry {
+    pub fn new() -> Self {
+        Self {
+            aliases: HashMap::new(),
+        }
+    }
+
+    pub fn normalize_alias(raw: &str) -> Result<String> {
+        let trimmed = raw.trim();
+
+        if !trimmed.is_ascii() {
+            return Err(anyhow!("Alias must contain only ASCII characters"));
+        }
+
+        let normalized = trimmed.to_ascii_lowercase();
+
+        if normalized.len() < ALIAS_MIN_LEN || normalized.len() > ALIAS_MAX_LEN {
+            return Err(anyhow!(
+                "Alias length must be {}-{} characters",
+                ALIAS_MIN_LEN,
+                ALIAS_MAX_LEN
+            ));
+        }
+
+        if !normalized
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+        {
+            return Err(anyhow!("Alias must contain only [a-z0-9_-]"));
+        }
+
+        Ok(normalized)
+    }
+
+    pub fn register(&mut self, alias: &str, blob_ticket: &str) -> Result<()> {
+        let normalized = Self::normalize_alias(alias)?;
+
+        if blob_ticket.trim().is_empty() {
+            return Err(anyhow!("BlobTicket must not be empty"));
+        }
+
+        self.prune_expired();
+
+        if self.aliases.contains_key(&normalized) {
+            return Err(anyhow!("Alias already registered"));
+        }
+
+        self.aliases.insert(
+            normalized,
+            AliasEntry {
+                blob_ticket: blob_ticket.to_string(),
+                registered_at: Instant::now(),
+            },
+        );
+
+        Ok(())
+    }
+
+    pub fn resolve(&mut self, alias: &str) -> Result<String> {
+        let normalized = Self::normalize_alias(alias)?;
+
+        let Some(entry) = self.aliases.get(&normalized) else {
+            return Err(anyhow!("Alias not found"));
+        };
+
+        if entry.registered_at.elapsed() >= Duration::from_secs(ALIAS_TTL_SECS) {
+            self.aliases.remove(&normalized);
+            return Err(anyhow!("Alias expired"));
+        }
+
+        if entry.blob_ticket.trim().is_empty() {
+            self.aliases.remove(&normalized);
+            return Err(anyhow!("Invalid BlobTicket"));
+        }
+
+        Ok(entry.blob_ticket.clone())
+    }
+
+    pub fn clear(&mut self) {
+        self.aliases.clear();
+    }
+
+    pub fn prune_expired(&mut self) {
+        let ttl = Duration::from_secs(ALIAS_TTL_SECS);
+        self.aliases
+            .retain(|_, entry| entry.registered_at.elapsed() < ttl);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn normalization_and_ascii_validation() {
+        assert_eq!(
+            LanAliasRegistry::normalize_alias("  MyCode123  ").unwrap(),
+            "mycode123"
+        );
+        assert_eq!(
+            LanAliasRegistry::normalize_alias("UPPERCASE").unwrap(),
+            "uppercase"
+        );
+
+        for value in ["café", "日本語", "naïve", "Übung"] {
+            assert!(LanAliasRegistry::normalize_alias(value).is_err());
+        }
+    }
+
+    #[test]
+    fn normalization_rejects_invalid_characters() {
+        for value in ["foo@bar", "code#123", "test.com", "foo bar"] {
+            assert!(LanAliasRegistry::normalize_alias(value).is_err());
+        }
+    }
+
+    #[test]
+    fn normalization_rejects_invalid_lengths() {
+        assert!(LanAliasRegistry::normalize_alias("foo").is_err());
+        assert!(LanAliasRegistry::normalize_alias(&"a".repeat(33)).is_err());
+    }
+
+    #[test]
+    fn register_and_resolve() {
+        let mut registry = LanAliasRegistry::new();
+        registry
+            .register("MyAlias", "real_blob_ticket_xyz")
+            .unwrap();
+
+        assert_eq!(
+            registry.resolve("myalias").unwrap(),
+            "real_blob_ticket_xyz"
+        );
+    }
+
+    #[test]
+    fn duplicate_registration_does_not_overwrite() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("samealias", "ticket1").unwrap();
+
+        assert!(registry.register("samealias", "ticket2").is_err());
+        assert_eq!(registry.resolve("samealias").unwrap(), "ticket1");
+    }
+
+    #[test]
+    fn ttl_and_expired_are_distinct_from_missing() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("expired", "ticket1").unwrap();
+
+        if let Some(entry) = registry.aliases.get_mut("expired") {
+            entry.registered_at =
+                Instant::now() - Duration::from_secs(ALIAS_TTL_SECS + 1);
+        }
+
+        let expired = registry.resolve("expired").unwrap_err().to_string();
+        assert!(expired.contains("expired"));
+        assert!(!registry.aliases.contains_key("expired"));
+
+        let missing = registry.resolve("missing").unwrap_err().to_string();
+        assert!(missing.contains("not found"));
+    }
+
+    #[test]
+    fn prune_expired_removes_only_stale_entries() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("fresh", "ticket1").unwrap();
+        registry.register("stale", "ticket2").unwrap();
+
+        if let Some(entry) = registry.aliases.get_mut("stale") {
+            entry.registered_at =
+                Instant::now() - Duration::from_secs(ALIAS_TTL_SECS + 1);
+        }
+
+        registry.prune_expired();
+
+        assert!(registry.aliases.contains_key("fresh"));
+        assert!(!registry.aliases.contains_key("stale"));
+    }
+
+    #[test]
+    fn clear_removes_all_aliases() {
+        let mut registry = LanAliasRegistry::new();
+        registry.register("alias1", "ticket1").unwrap();
+        registry.register("alias2", "ticket2").unwrap();
+
+        registry.clear();
+
+        assert!(registry.resolve("alias1").is_err());
+        assert!(registry.resolve("alias2").is_err());
+    }
+
+    #[test]
+    fn empty_ticket_is_rejected() {
+        let mut registry = LanAliasRegistry::new();
+        assert!(registry.register("alias1", "").is_err());
+        assert!(registry.register("alias2", "   ").is_err());
+    }
+}
